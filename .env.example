# Application
APP_NAME=Anglo_Central_Portal
NODE_ENV=development
PORT=3000
# BASE_URL must be your public-facing domain in production (used for password reset email links)
# e.g. https://apps.anglosingapore.ac.th
BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok

# Database (MSSQL)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=AngloCentralPortal
DB_USER=portal_user
DB_PASSWORD=your_password_here
DB_ENCRYPT=false

# Session
SESSION_SECRET=your_session_secret_here_change_in_production

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# SMTP (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@anglosingapore.ac.th
SMTP_PASS=your_smtp_app_password

# SSO (JWT-based Single Sign-On for external applications)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Share this secret with external applications that need to verify SSO tokens locally
SSO_JWT_SECRET=your_sso_jwt_secret_here
