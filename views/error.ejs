<div class="error-page">
  <div class="container">
    <div class="error-content">
      <div class="error-icon">
        <i class="bi bi-shield-x"></i>
      </div>
      <h1 class="error-title"><%= typeof title !== 'undefined' ? title : 'Error' %></h1>
      <p class="error-message"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
      <a href="/" class="btn btn-primary-portal mt-3">
        <i class="bi bi-house-door me-1"></i> Back to Dashboard
      </a>
    </div>
  </div>
</div>
