<div class="admin-page">
  <div class="container">
    <div class="admin-header">
      <div class="admin-header-text">
        <h1 class="admin-title"><i class="bi bi-app-indicator me-2"></i>Application Registry</h1>
        <p class="admin-subtitle">Manage registered applications and their configurations.</p>
      </div>
      <div class="admin-header-actions">
        <a href="/admin/applications/new" class="btn btn-primary-portal">
          <i class="bi bi-plus-lg me-1"></i> Add Application
        </a>
      </div>
    </div>

    <!-- Flash messages -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span><%= success %></span>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (applications && applications.length > 0) { %>
      <!-- Summary -->
      <div class="admin-stats">
        <div class="stat-card">
          <div class="stat-value"><%= total %></div>
          <div class="stat-label">Total Apps</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.ActiveCount %></div>
          <div class="stat-label">Active</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.InactiveCount %></div>
          <div class="stat-label">Inactive</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.UniqueApps %></div>
          <div class="stat-label">Unique Apps</div>
        </div>
      </div>

      <!-- Applications table -->
      <div class="table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Application</th>
              <th>Code</th>
              <th>Campus</th>
              <th>Type</th>
              <th>Technology</th>
              <th>Status</th>
              <th>Order</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(app => { %>
              <tr class="<%= app.Status !== 'Active' ? 'row-inactive' : '' %>">
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="app-icon-sm">
                      <i class="bi bi-<%= app.Icon || 'app-indicator' %>"></i>
                    </div>
                    <div>
                      <div class="fw-semibold"><%= app.Application %></div>
                      <div class="text-muted small text-truncate app-table-link" style="max-width: 250px;" title="<%= app.Link %>"><%= app.Link %></div>
                    </div>
                  </div>
                </td>
                <td><code><%= app.ApplicationCode %></code></td>
                <td><%= app.Campus || '—' %></td>
                <td><%= app.Name || '—' %></td>
                <td><%= app.Technology || '—' %></td>
                <td>
                  <span class="status-badge status-<%= app.Status === 'Active' ? 'active' : 'inactive' %>">
                    <%= app.Status %>
                  </span>
                </td>
                <td><%= app.DisplayOrder %></td>
                <td>
                  <div class="action-btns">
                    <a href="/admin/applications/<%= app.Id %>/edit" class="btn-action btn-action-edit" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form method="POST" action="/admin/applications/<%= app.Id %>/toggle" class="d-inline"
                          data-confirm="Are you sure you want to <%= app.Status === 'Active' ? 'DEACTIVATE this application? ' + app.Application + ' will be hidden from users on the dashboard.' : 'ACTIVATE ' + app.Application + '?' %>"
                          data-confirm-title="<%= app.Status === 'Active' ? 'Deactivate Application' : 'Activate Application' %>"
                          data-confirm-btn="<%= app.Status === 'Active' ? 'Deactivate' : 'Activate' %>"
                          data-confirm-type="<%= app.Status === 'Active' ? 'warning' : 'primary' %>">
                      <button type="submit" class="btn-action btn-action-toggle" title="<%= app.Status === 'Active' ? 'Deactivate' : 'Activate' %>">
                        <i class="bi bi-<%= app.Status === 'Active' ? 'pause-circle' : 'play-circle' %>"></i>
                      </button>
                    </form>
                    <form method="POST" action="/admin/applications/<%= app.Id %>/delete" class="d-inline"
                          data-confirm="Are you sure you want to permanently delete '<%= app.Application %>'? This will remove the application and role assignments. This action cannot be undone."
                          data-confirm-title="Delete Application"
                          data-confirm-btn="Delete"
                          data-confirm-type="danger">
                      <button type="submit" class="btn-action btn-action-delete" title="Delete">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination footer -->
      <div class="table-pagination">
        <div class="table-pagination-left">
          <label for="apps-rpp" class="pagination-rpp-label">Rows per page:</label>
          <select id="apps-rpp" class="pagination-rpp-select" data-base-url="/admin/applications" aria-label="Rows per page">
            <% allowedLimits.forEach(opt => { %>
              <option value="<%= opt %>" <%= opt === limit ? 'selected' : '' %>><%= opt %></option>
            <% }) %>
          </select>
        </div>
        <div class="table-pagination-right">
          <span class="pagination-range">
            <%= (page - 1) * limit + 1 %>–<%= Math.min(page * limit, total) %> of <%= total %>
          </span>
          <nav class="pagination-actions" aria-label="Table navigation">
            <% if (page > 1) { %>
              <a href="/admin/applications?page=<%= page - 1 %>&limit=<%= limit %>" class="pagination-btn" aria-label="Previous page">
                <i class="bi bi-chevron-left"></i>
              </a>
            <% } else { %>
              <span class="pagination-btn disabled" aria-disabled="true"><i class="bi bi-chevron-left"></i></span>
            <% } %>
            <span class="pagination-info">Page <%= page %> of <%= totalPages %></span>
            <% if (page < totalPages) { %>
              <a href="/admin/applications?page=<%= page + 1 %>&limit=<%= limit %>" class="pagination-btn" aria-label="Next page">
                <i class="bi bi-chevron-right"></i>
              </a>
            <% } else { %>
              <span class="pagination-btn disabled" aria-disabled="true"><i class="bi bi-chevron-right"></i></span>
            <% } %>
          </nav>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-inbox"></i></div>
        <h2 class="empty-state-title">No Applications Registered</h2>
        <p class="empty-state-text">Add your first application to the registry.</p>
        <a href="/admin/applications/new" class="btn btn-primary-portal mt-3">
          <i class="bi bi-plus-lg me-1"></i> Add Application
        </a>
      </div>
    <% } %>
  </div>
</div>
