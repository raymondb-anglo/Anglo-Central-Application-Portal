<div class="admin-page">
  <div class="container">
    <div class="admin-header">
      <div class="admin-header-text">
        <h1 class="admin-title"><i class="bi bi-people me-2"></i>User Management</h1>
        <p class="admin-subtitle">Manage portal users, roles, and application access.</p>
      </div>
      <div class="admin-header-actions">
        <a href="/admin/users/new" class="btn btn-primary-portal">
          <i class="bi bi-person-plus me-1"></i> Add User
        </a>
        <button type="button" class="btn btn-secondary-portal" data-bs-toggle="modal" data-bs-target="#importUsersModal">
          <i class="bi bi-file-earmark-arrow-up me-1"></i> Bulk Import (CSV)
        </button>
        <a href="/admin/users/template" class="btn btn-secondary-portal" title="Download sample CSV template">
          <i class="bi bi-download me-1"></i> Download Template
        </a>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i><span><%= success %></span></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle-fill"></i><span><%= error %></span></div>
    <% } %>

    <% if (users && users.length > 0) { %>
      <div class="admin-stats">
        <div class="stat-card"><div class="stat-value"><%= total %></div><div class="stat-label">Total Users</div></div>
        <div class="stat-card"><div class="stat-value"><%= stats.ActiveCount %></div><div class="stat-label">Active</div></div>
        <div class="stat-card"><div class="stat-value"><%= stats.InactiveCount %></div><div class="stat-label">Inactive</div></div>
      </div>

      <div class="table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Email</th>
              <th>Roles</th>
              <th>Status</th>
              <th>Last Login</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr class="<%= !u.IsActive ? 'row-inactive' : '' %>">
                <td>
                  <div class="fw-semibold"><%= u.DisplayName || (u.FirstName + ' ' + u.LastName).trim() || '—' %></div>
                </td>
                <td><%= u.Email %></td>
                <td>
                  <% if (u.RoleNames) { %>
                    <% u.RoleNames.split(', ').forEach(role => { %>
                      <span class="role-badge"><%= role %></span>
                    <% }) %>
                  <% } else { %>
                    <span class="text-muted small fst-italic">No roles</span>
                  <% } %>
                </td>
                <td>
                  <span class="status-badge status-<%= u.IsActive ? 'active' : 'inactive' %>">
                    <%= u.IsActive ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="text-muted small">
                  <%= u.LastLoginAt ? new Date(u.LastLoginAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Never' %>
                </td>
                <td>
                  <div class="action-btns">
                    <a href="/admin/users/<%= u.Id %>/edit" class="btn-action btn-action-edit" title="Edit"><i class="bi bi-pencil"></i></a>
                    <form method="POST" action="/admin/users/<%= u.Id %>/toggle" class="d-inline"
                          data-confirm="Are you sure you want to <%= u.IsActive ? 'DEACTIVATE ' + (u.DisplayName || u.Email) + '? This user will not be able to log in to the portal.' : 'ACTIVATE ' + (u.DisplayName || u.Email) + '?' %>"
                          data-confirm-title="<%= u.IsActive ? 'Deactivate User' : 'Activate User' %>"
                          data-confirm-btn="<%= u.IsActive ? 'Deactivate' : 'Activate' %>"
                          data-confirm-type="<%= u.IsActive ? 'danger' : 'primary' %>">
                      <button type="submit" class="btn-action btn-action-toggle" title="<%= u.IsActive ? 'Deactivate' : 'Activate' %>">
                        <i class="bi bi-<%= u.IsActive ? 'pause-circle' : 'play-circle' %>"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination footer -->
      <div class="table-pagination">
        <div class="table-pagination-left">
          <label for="users-rpp" class="pagination-rpp-label">Rows per page:</label>
          <select id="users-rpp" class="pagination-rpp-select" data-base-url="/admin/users" aria-label="Rows per page">
            <% allowedLimits.forEach(opt => { %>
              <option value="<%= opt %>" <%= opt === limit ? 'selected' : '' %>><%= opt %></option>
            <% }) %>
          </select>
        </div>
        <div class="table-pagination-right">
          <span class="pagination-range">
            <%= (page - 1) * limit + 1 %>–<%= Math.min(page * limit, total) %> of <%= total %>
          </span>
          <nav class="pagination-actions" aria-label="Table navigation">
            <% if (page > 1) { %>
              <a href="/admin/users?page=<%= page - 1 %>&limit=<%= limit %>" class="pagination-btn" aria-label="Previous page">
                <i class="bi bi-chevron-left"></i>
              </a>
            <% } else { %>
              <span class="pagination-btn disabled" aria-disabled="true"><i class="bi bi-chevron-left"></i></span>
            <% } %>
            <span class="pagination-info">Page <%= page %> of <%= totalPages %></span>
            <% if (page < totalPages) { %>
              <a href="/admin/users?page=<%= page + 1 %>&limit=<%= limit %>" class="pagination-btn" aria-label="Next page">
                <i class="bi bi-chevron-right"></i>
              </a>
            <% } else { %>
              <span class="pagination-btn disabled" aria-disabled="true"><i class="bi bi-chevron-right"></i></span>
            <% } %>
          </nav>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-people"></i></div>
        <h2 class="empty-state-title">No Users</h2>
        <p class="empty-state-text">Users will appear here when they log in via Google OAuth or are added manually.</p>
      </div>
    <% } %>
  </div>

  <!-- Bulk Import Users Modal -->
  <div class="modal fade" id="importUsersModal" tabindex="-1" aria-labelledby="importUsersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="POST" action="/admin/users/import" enctype="multipart/form-data">
          <div class="modal-header border-0 pb-0">
            <h5 class="modal-title fw-bold" id="importUsersModalLabel">
              <i class="bi bi-file-earmark-arrow-up text-primary me-2"></i>Bulk Import Users
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body py-3">
            <p class="text-muted small mb-3">
              Upload a CSV file to create or update user accounts in bulk. Unspecified roles default to <strong>Student</strong> (suitable for parents to access live booking sites).
            </p>

            <div class="mb-3">
              <label for="csvFile" class="form-label fw-semibold">Select CSV File (.csv)</label>
              <input type="file" class="form-control" id="csvFile" name="csvFile" accept=".csv" required>
            </div>

            <div class="p-3 rounded-3" style="background: rgba(148, 163, 184, 0.08); font-size: 0.85rem;">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold">CSV Column Format:</span>
                <a href="/admin/users/template" class="text-decoration-none small">
                  <i class="bi bi-download me-1"></i>Download Template
                </a>
              </div>
              <code class="d-block text-secondary mb-2" style="word-break: break-all;">Email,DisplayName,FirstName,LastName,Role,Campus</code>
              <div class="text-muted small">
                • <strong>Email</strong> is required.<br>
                • <strong>Role</strong> defaults to <code>Student</code> if blank.<br>
                • <strong>Campus</strong> (e.g. <code>64</code>, <code>31</code>, or <code>Korat</code>) will automatically map live campus booking apps.
              </div>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-secondary-portal" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary-portal">
              <i class="bi bi-cloud-arrow-up me-1"></i> Start Import
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
