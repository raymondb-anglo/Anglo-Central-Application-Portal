<div class="dashboard-page">
  <!-- Welcome header -->
  <div class="dashboard-header">
    <div class="container">
      <div class="dashboard-welcome">
        <div class="welcome-text">
          <h1 class="welcome-title">
            Welcome back<% if (user && user.FirstName) { %>, <span class="welcome-name"><%= user.FirstName %></span><% } %>
          </h1>
          <p class="welcome-subtitle">Select an application to get started</p>
        </div>
        <div class="welcome-meta">
          <span class="badge badge-portal">
            <i class="bi bi-clock me-1"></i>
            <span id="current-time"></span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger d-flex align-items-center gap-2 mt-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <% 
      const favSet = new Set(typeof favoriteAppIds !== 'undefined' ? favoriteAppIds : []);
      const pinnedApps = (applications || []).filter(a => favSet.has(a.Id));
    %>

    <!-- Recently Used Section (User Personalization) -->
    <% if (typeof recentApps !== 'undefined' && recentApps.length > 0) { %>
      <div class="recent-launches-section mb-4" id="recentLaunchesSection">
        <div class="section-header d-flex align-items-center justify-content-between mb-2">
          <span class="section-title text-muted small fw-bold text-uppercase d-flex align-items-center gap-1">
            <i class="bi bi-clock-history text-primary"></i> Recently Used
          </span>
          <span class="text-muted extra-small">Quick access to your latest apps</span>
        </div>
        <div class="recent-launches-scroll">
          <% recentApps.forEach(app => { %>
            <a href="/launch/<%= app.Id %>" class="recent-launch-chip" target="_blank" rel="noopener noreferrer" title="<%= app.Application %><%= app.Campus ? ' — ' + app.Campus : '' %>">
              <div class="chip-icon" data-app="<%= app.ApplicationCode %>">
                <i class="bi bi-<%= app.Icon || 'app-indicator' %>"></i>
              </div>
              <div class="chip-info">
                <span class="chip-title"><%= app.Application %></span>
                <span class="chip-meta"><%= app.Campus || 'Global' %></span>
              </div>
              <i class="bi bi-box-arrow-up-right chip-arrow"></i>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (applications && applications.length > 0) { %>
      <!-- Pinned Favorites Section (User Personalization) -->
      <div class="pinned-section mb-4" id="pinnedSection" style="<%= pinnedApps.length === 0 ? 'display: none;' : '' %>">
        <div class="section-header d-flex align-items-center justify-content-between mb-3">
          <h2 class="section-heading mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-star-fill text-warning"></i>
            <span>Pinned Favorites</span>
            <span class="badge badge-portal ms-1" id="pinnedCountBadge"><%= pinnedApps.length %></span>
          </h2>
          <span class="text-muted extra-small">Personalized for quick access</span>
        </div>
        <div class="app-grid pinned-grid" id="pinnedAppGrid">
          <% pinnedApps.forEach(app => { %>
            <div class="app-card-wrapper" data-app-id="<%= app.Id %>" data-pinned="true">
              <a href="/launch/<%= app.Id %>"
                 class="app-card"
                 data-campus="<%= app.Campus || 'global' %>"
                 data-app-code="<%= app.ApplicationCode %>"
                 data-app-id="<%= app.Id %>"
                 target="_blank"
                 rel="noopener noreferrer"
                 title="<%= app.Application %><%= app.Campus ? ' — ' + app.Campus : '' %>">
                <!-- Favorite Toggle Button -->
                <button type="button" 
                        class="app-favorite-btn active" 
                        data-app-id="<%= app.Id %>" 
                        title="Remove from favorites" 
                        aria-label="Remove from favorites">
                  <i class="bi bi-star-fill"></i>
                </button>
                <div class="app-card-icon" data-app="<%= app.ApplicationCode %>">
                  <i class="bi bi-<%= app.Icon || 'app-indicator' %>"></i>
                </div>
                <div class="app-card-body">
                  <h3 class="app-card-title"><%= app.Application %></h3>
                  <% if (app.Description) { %>
                    <p class="app-card-desc"><%= app.Description %></p>
                  <% } %>
                  <div class="app-card-meta">
                    <% if (app.Campus) { %>
                      <span class="app-card-campus">
                        <i class="bi bi-building me-1"></i><%= app.Campus %>
                      </span>
                    <% } %>
                    <% if (app.Name) { %>
                      <span class="app-card-type">
                        <i class="bi bi-person me-1"></i><%= app.Name %>
                      </span>
                    <% } %>
                  </div>
                </div>
                <div class="app-card-arrow">
                  <i class="bi bi-arrow-right"></i>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Main Applications Section Header & Filter Tabs -->
      <div class="all-apps-header d-flex align-items-center justify-content-between mb-2">
        <h2 class="section-heading mb-0 d-flex align-items-center gap-2">
          <i class="bi bi-grid-3x3-gap text-primary"></i>
          <span>All Applications</span>
        </h2>
      </div>

      <div class="app-filter-bar">
        <div class="filter-label">
          <i class="bi bi-funnel me-1"></i> Filter
        </div>
        <div class="filter-tabs">
          <button class="filter-tab active" data-campus="all">All</button>
          <% if (typeof campuses !== 'undefined' && campuses.length > 0) { %>
            <% campuses.forEach(campus => { %>
              <button class="filter-tab" data-campus="<%= campus %>"><%= campus %></button>
            <% }) %>
          <% } %>
          <% const hasGlobal = applications.some(app => !app.Campus); %>
          <% if (hasGlobal) { %>
            <button class="filter-tab" data-campus="global">
              <i class="bi bi-globe2 me-1"></i>Global
            </button>
          <% } %>
        </div>
        <div class="dashboard-search-box ms-auto d-flex align-items-center gap-2">
          <button type="button" class="dashboard-search-btn" id="dashboardSearchBtn" title="Quick Search applications (Ctrl + K)">
            <i class="bi bi-search me-1"></i>
            <span class="d-none d-sm-inline">Search</span>
            <kbd class="shortcut-pill d-none d-md-inline ms-1">Ctrl K</kbd>
          </button>
          <div class="app-count">
            <span class="badge badge-portal" id="app-count-badge">
              <i class="bi bi-grid-3x3 me-1"></i><span id="visible-count"><%= applications.length %></span> apps
            </span>
          </div>
        </div>
      </div>

      <!-- Health status summary -->
      <div class="health-summary" id="health-summary" style="display:none;">
        <div class="health-summary-label">
          <i class="bi bi-activity me-1"></i> System Status
        </div>
        <div class="health-summary-badges">
          <span class="health-summary-item health-summary-online">
            <span class="health-dot"></span>
            <span id="health-online-count">0</span> Online
          </span>
          <span class="health-summary-item health-summary-degraded">
            <span class="health-dot"></span>
            <span id="health-degraded-count">0</span> Slow
          </span>
          <span class="health-summary-item health-summary-offline">
            <span class="health-dot"></span>
            <span id="health-offline-count">0</span> Offline
          </span>
        </div>
        <div class="health-summary-meta ms-auto">
          <span class="health-last-checked" id="health-last-checked"></span>
        </div>
      </div>

      <div class="app-grid" id="app-grid">
        <% applications.forEach(app => { %>
          <% const isFav = favSet.has(app.Id); %>
          <div class="app-card-wrapper" data-app-id="<%= app.Id %>">
            <a href="/launch/<%= app.Id %>"
               class="app-card"
               data-campus="<%= app.Campus || 'global' %>"
               data-app-code="<%= app.ApplicationCode %>"
               data-app-id="<%= app.Id %>"
               target="_blank"
               rel="noopener noreferrer"
               title="<%= app.Application %><%= app.Campus ? ' — ' + app.Campus : '' %>">
              
              <!-- Health status badge -->
              <span class="health-badge health-unknown"
                    data-health-id="<%= app.Id %>"
                    title="Checking status...">
                <span class="health-dot"></span>
                <span class="health-label">—</span>
              </span>

              <!-- Favorite Toggle Button -->
              <button type="button" 
                      class="app-favorite-btn <%= isFav ? 'active' : '' %>" 
                      data-app-id="<%= app.Id %>" 
                      title="<%= isFav ? 'Remove from favorites' : 'Pin to favorites' %>" 
                      aria-label="<%= isFav ? 'Remove from favorites' : 'Pin to favorites' %>">
                <i class="bi <%= isFav ? 'bi-star-fill' : 'bi-star' %>"></i>
              </button>

              <div class="app-card-icon" data-app="<%= app.ApplicationCode %>">
                <i class="bi bi-<%= app.Icon || 'app-indicator' %>"></i>
              </div>
              <div class="app-card-body">
                <h3 class="app-card-title"><%= app.Application %></h3>
                <% if (app.Description) { %>
                  <p class="app-card-desc"><%= app.Description %></p>
                <% } %>
                <div class="app-card-meta">
                  <% if (app.Campus) { %>
                    <span class="app-card-campus">
                      <i class="bi bi-building me-1"></i><%= app.Campus %>
                    </span>
                  <% } %>
                  <% if (app.Name) { %>
                    <span class="app-card-type">
                      <i class="bi bi-person me-1"></i><%= app.Name %>
                    </span>
                  <% } %>
                </div>
              </div>
              <div class="app-card-arrow">
                <i class="bi bi-arrow-right"></i>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <!-- Empty state -->
      <div class="empty-state">
        <div class="empty-state-icon">
          <i class="bi bi-inbox"></i>
        </div>
        <h2 class="empty-state-title">No Applications Available</h2>
        <p class="empty-state-text">
          Applications will appear here once they are registered in the portal.
        </p>
        <% if (typeof userRoles !== 'undefined' && (userRoles.includes('PortalAdmin') || userRoles.includes('ITAdmin'))) { %>
          <a href="/admin/applications" class="btn btn-primary-portal mt-3">
            <i class="bi bi-plus-lg me-1"></i> Add Application
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
