<nav class="navbar navbar-expand-lg portal-navbar">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <div class="brand-icon">
        <i class="bi bi-grid-3x3-gap-fill"></i>
      </div>
      <div class="brand-text">
        <span class="brand-name">Anglo</span>
        <span class="brand-subtitle">Application Portal</span>
      </div>
    </a>

    <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
      <!-- Desktop Quick Switcher Trigger -->
      <button class="quick-switcher-nav-trigger d-none d-lg-flex align-items-center" type="button" id="navQuickSwitcherBtn" title="Search applications, admin tools, and actions (Ctrl + K)">
        <i class="bi bi-search me-2"></i>
        <span class="switcher-placeholder">Search apps, tools, actions...</span>
        <kbd class="shortcut-badge ms-auto">Ctrl K</kbd>
      </button>

      <div class="d-flex align-items-center gap-2 d-lg-none ms-auto me-2">
        <!-- Mobile Quick Switcher Trigger (Direct touch access for phones) -->
        <button class="quick-switcher-mobile-trigger" type="button" id="mobileQuickSwitcherBtn" aria-label="Quick Search" title="Quick Search">
          <i class="bi bi-search"></i>
        </button>
      </div>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item">
            <a class="nav-link" href="/">
              <i class="bi bi-house-door"></i> Dashboard
            </a>
          </li>

          <% if (typeof userRoles !== 'undefined' && (userRoles.includes('PortalAdmin') || userRoles.includes('ITAdmin'))) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <i class="bi bi-gear"></i> Admin
              </a>
              <ul class="dropdown-menu portal-dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/admin/applications"><i class="bi bi-app-indicator me-2"></i>Applications</a></li>
                <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people me-2"></i>Users</a></li>
                <li><a class="dropdown-item" href="/admin/roles"><i class="bi bi-shield-lock me-2"></i>Roles</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/admin/audit-logs"><i class="bi bi-journal-text me-2"></i>Audit Logs</a></li>
              </ul>
            </li>
          <% } %>

          <li class="nav-item">
            <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Toggle theme">
              <i class="bi bi-brightness-high theme-icon-sun"></i>
              <i class="bi bi-moon theme-icon-moon"></i>
              <span class="theme-toggle-text">Light Mode</span>
            </button>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
              <% if (user && user.ProfilePicture) { %>
                <img src="<%= user.ProfilePicture %>" alt="Profile" class="user-avatar">
              <% } else { %>
                <div class="user-avatar-placeholder">
                  <i class="bi bi-person-fill"></i>
                </div>
              <% } %>
              <span class="d-none d-md-inline"><%= user ? user.DisplayName || user.Email : 'User' %></span>
            </a>
            <ul class="dropdown-menu portal-dropdown-menu dropdown-menu-end">
              <li class="dropdown-item-text text-muted small">
                <i class="bi bi-envelope me-1"></i>
                <%= user ? user.Email : '' %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item text-danger" href="/auth/logout">
                  <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                </a>
              </li>
            </ul>
          </li>
        </ul>
      </div>
    <% } else { %>
      <div class="d-flex align-items-center ms-auto">
        <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Toggle theme">
          <i class="bi bi-brightness-high theme-icon-sun"></i>
          <i class="bi bi-moon theme-icon-moon"></i>
          <span class="theme-toggle-text">Light Mode</span>
        </button>
      </div>
    <% } %>
  </div>
</nav>
