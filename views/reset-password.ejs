<div class="login-page">
  <!-- Animated background -->
  <div class="login-bg">
    <div class="login-bg-shape shape-1"></div>
    <div class="login-bg-shape shape-2"></div>
    <div class="login-bg-shape shape-3"></div>
  </div>

  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="login-icon" style="background: linear-gradient(135deg, #10b981, #06b6d4);">
          <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1 class="login-title">Reset Password</h1>
        <p class="login-subtitle">Enter your new password below</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/auth/reset-password" class="auth-form">
        <input type="hidden" name="token" value="<%= token %>">

        <div class="auth-input-group">
          <label for="rp-password" class="form-label">New Password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control" id="rp-password" name="password" placeholder="Minimum 8 characters" minlength="8" required>
              <button type="button" class="password-toggle-btn" aria-label="Show password" data-target="rp-password">
                <i class="bi bi-eye-slash"></i>
              </button>
          </div>
        </div>

        <div class="auth-input-group">
          <label for="rp-confirm" class="form-label">Confirm New Password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
            <input type="password" class="form-control" id="rp-confirm" name="confirmPassword" placeholder="Re-enter your password" minlength="8" required>
              <button type="button" class="password-toggle-btn" aria-label="Show password" data-target="rp-confirm">
                <i class="bi bi-eye-slash"></i>
              </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary-portal w-100">
          <i class="bi bi-check-lg me-1"></i> Reset Password
        </button>
      </form>

      <div class="otp-actions" style="margin-top: 1.25rem;">
        <a href="/auth/login?tab=password" class="btn-link-portal">
          <i class="bi bi-arrow-left me-1"></i> Back to Sign In
        </a>
      </div>

      <!-- Footer -->
      <div class="login-footer">
        <p class="login-footer-text"><i class="bi bi-shield-lock-fill"></i> Secured by Anglo Singapore IT</p>
      </div>
    </div>
  </div>
</div>
